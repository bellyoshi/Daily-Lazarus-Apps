# Lazarus/Free Pascal - プロジェクトの一時ファイルとバイナリ

# 実行ファイル (Windows)
*.exe
# 実行ファイル (Linux/macOS - 拡張子なしのバイナリを想定)
[A-Za-z0-9]*
!*.pas
!*.lfm
!*.lpi
!*.lpr
!*.res
!*.ico
!*.txt
!*.md
!*.gitignore

# コンパイル済みユニット (一時ファイル)
*.o
*.ppu
*.obj
*.compiled
*.ppu
*.ppu
*.or

# バックアップファイル
backup/
*.bak
*.~*

# Lazarus固有の設定ファイル（個人環境に依存するもの）
*.lps
lib/

# OS固有のファイル
.DS_Store
Thumbs.db